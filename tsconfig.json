{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "allowJs": true, "checkJs": false,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noEmit": true, "types": ["node"]
  },
  "include": ["server/**/*.ts"], "exclude": ["node_modules", "src-tauri"]
}
