# Copy settings into an ignored local environment file. Never commit actual secrets.
NODE_ENV=development
PORT=8001
APP_BASE_URL=http://127.0.0.1:8001
DATABASE_URL=postgresql://appscreen:appscreen_local_only@127.0.0.1:55432/appscreen
APPSCREEN_DEV_AUTH=true
APPSCREEN_EMBEDDED_WORKER=true
APPSCREEN_ENABLE_AI=false
# Leave OAuth disabled until provider security and real-client consent tests pass.
APPSCREEN_MCP_OAUTH=false
# Transactional service mail stays off until the provider/sender and live tests
# are approved. Opt-in notifications only; Supabase owns recovery/sign-in mail.
APPSCREEN_EMAIL_ENABLED=false
APPSCREEN_EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Comma-separated exact Supabase user UUIDs, never emails. Empty disables staff access.
# Production operator sessions require verified MFA (aal2); MCP is never staff access.
APPSCREEN_OPERATOR_USER_IDS=
# Required for production; use a cryptographically random secret, >=48 characters.
APPSCREEN_SIGNING_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Auth admin credential; also used by Storage in legacy single-project setups.
# With split Storage and service email disabled, this may remain empty.
SUPABASE_SERVICE_ROLE_KEY=
# Optional paired overrides for separate Auth and Storage installations.
# Set both or neither. Use a canonical HTTPS origin (no trailing slash).
# Storage service-role credentials remain installation-wide, NOT bucket-scoped.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=appscreen-private
# Keep jwks for asymmetric signing. Explicit HS256 self-hosted compatibility:
# auth-server verifies each browser bearer with Supabase; MCP OAuth must stay off.
SUPABASE_AUTH_VERIFICATION=jwks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Set only after confirming actual configured Stripe price and business policy.
PRO_PRICE_AMOUNT=
PRO_PRICE_CURRENCY=usd
TRIAL_CREDITS=5
PRO_MONTHLY_CREDITS=100
DESIGN_CREDITS=5
REVISION_CREDITS=1
